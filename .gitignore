# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/

# Test / type-check caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
.venv-*/
venv/
env/

# Build output
build/
# 패키지 소스 디렉터리(GENERIC-B 빌드 어댑터)는 산출물이 아니므로 위 규칙에서 제외
!logosfuzz/generate/build/
dist/
*.o
*.out
a.out

# Secrets and local config
.env
.env.local
*.key
config/secrets.yaml

# IDE / editor
.vscode/
.idea/
*.code-workspace

# Local tool state
.claude/settings.local.json
.claude/worktrees/

# OS
.DS_Store
Thumbs.db
desktop.ini
*.tmp
~$*

# ---- LogosFuzz artifacts ----

# Fuzzing results
crashes/
corpus/
harnesses/
*.log
crash-*

# 파이프라인이 생성한 하네스와 컴파일 산출물 (실행할 때마다 새로 만들어짐)
generated_harness*.c
examples/**/buffer_overflow
examples/**/fuzz_target
validation/**/bin/

# Generated reports and analysis output
out/
output/
ana_05_02_cve_reporting/output/

# Knowledge base / vector store caches
vector_db/
*.faiss
*.index

# Local toolchain binaries
Bear64.exe
*.pid

# 분석 대상 업스트림 소스 (sparse clone, 커밋 제외)
# 재현: git clone --depth 1 --filter=blob:none --sparse \
#         https://github.com/eclipse-score/baselibs.git third_party/score-baselibs
#       git -C third_party/score-baselibs sparse-checkout set score
# libsndfile(범용 대상)은 고정 커밋으로 수신: bash scripts/fetch_libsndfile.sh --build
third_party/

# LogosFuzz 런타임 상태(HITL 리뷰 저장소, KB 오버라이드, 감사 로그)
.logosfuzz/

# GENERIC-C 임베디드 샘플 빌드 산출물
examples/embedded/build-fuzz*/
