# GEN-03-02 자가치유 에러 코퍼스 수집/재현 이미지
# ==============================================================
#
# docker/Dockerfile(EXE-04-01 퍼징 실행 이미지)과 별개
# 하네스 격리 실행용이 아니라 Bazel 을 고의로 파손해 에러 원문을 수집하는 이미지
#
# 베이스 ubuntu:24.04 고정 — 코퍼스 수집 환경이 clang 18.1.3 / Ubuntu 24.04
# sanitizer 진단 문구가 clang 메이저 버전마다 달라 같은 조합에서만 재현 가능
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive \
    TZ=Asia/Seoul

#   libclang-rt-18-dev 누락 시 컴파일은 통과하고 링크에서 실패:
#     ld.lld: error: cannot open .../libclang_rt.fuzzer-x86_64.a: No such file or directory
#     ld.lld: error: cannot open .../libclang_rt.ubsan_standalone-x86_64.a: No such file or directory
#   clang 메타패키지에 compiler-rt 런타임 아카이브 미포함
#   -fsanitize=fuzzer / address / undefined 사용 시 별도 설치 필요
RUN apt-get update && apt-get install -y --no-install-recommends \
        clang \
        llvm \
        lld \
        libclang-rt-18-dev \
        python3 \
        curl \
        ca-certificates \
        git \
        zip \
        unzip \
        file \
    && rm -rf /var/lib/apt/lists/*

# bazelisk: .bazelversion 에 적힌 Bazel 버전 실행(재현 워크스페이스는 9.2.0 고정)
ARG BAZELISK_VERSION=v1.25.0
RUN curl -fsSL -o /usr/local/bin/bazel \
        "https://github.com/bazelbuild/bazelisk/releases/download/${BAZELISK_VERSION}/bazelisk-linux-amd64" \
    && chmod +x /usr/local/bin/bazel

# 수집 결과는 /repo(rw 마운트), Bazel 빌드는 컨테이너 내부 네이티브 FS 에서 수행
# 마운트 볼륨에서 빌드하면 느리고 심볼릭 링크가 깨짐
ENV SCRATCH=/scratch
RUN mkdir -p /scratch /repo
WORKDIR /repo

# 사용법:
#   docker build -f docker/Dockerfile.selfheal -t logosfuzz-selfheal .
#   docker run --rm -v "$PWD":/repo logosfuzz-selfheal
#
# 컨테이너 안에서 linux-sandbox 가 막히면(권한 부족) processwrapper-sandbox 로 자동 전환
# 에러 문장은 같지만 샌드박스 안내 한 줄이 달라질 수 있음. 바이트 단위 일치가 필요하면:
#   docker run --rm --privileged -v "$PWD":/repo logosfuzz-selfheal
CMD ["bash", "scripts/collect_selfheal_corpus.sh", "--out-root", "/repo", "--scratch", "/scratch"]
