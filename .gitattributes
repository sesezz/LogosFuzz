# 리눅스에서 실행되는 파일은 체크아웃 OS 와 무관하게 LF 강제
#
# Windows core.autocrlf=true 체크아웃 시 CRLF 변환 → WSL/Docker 에서 줄 끝 \r 이
# 인자에 붙어 오동작(`mkdir lib` -> `mkdir "lib\r"`)
# 수집한 에러 원문이 CRLF 로 바뀌면 픽스처 diff 전체가 어긋나는 문제 방지

*.sh            text eol=lf
*.bazel         text eol=lf
*.bzl           text eol=lf
.bazelrc        text eol=lf
.bazelversion   text eol=lf
docker/entrypoint.sh text eol=lf

# 자가치유 에러 코퍼스 — 실행 결과 원문이므로 바이트 단위 보존 필요
tests/fixtures/bazel_errors/**    text eol=lf
tests/fixtures/sanitizer_logs/**  text eol=lf
tests/fixtures/bazel_repro/**     text eol=lf
