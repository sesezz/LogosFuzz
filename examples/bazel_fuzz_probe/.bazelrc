# libFuzzer 는 clang 전용이다. GCC 에는 -fsanitize=fuzzer 가 없다
# (g++ 13.3 실측: "unrecognized argument to '-fsanitize=' option: 'fuzzer'").
# Ubuntu 기본 호스트 컴파일러가 gcc 이므로 명시적으로 clang 을 지정한다.
build --repo_env=CC=clang
build --repo_env=CXX=clang++

# 퍼징 엔진 배선: 대상 코드에 커버리지 계측(libfuzzer) + ASan.
build --@rules_fuzzing//fuzzing:cc_engine_instrumentation=libfuzzer
build --@rules_fuzzing//fuzzing:cc_engine_sanitizer=asan

# baselibs 가 크래시 시 쓰는 것과 같은 종료코드. 크래시 감지 로직이
# 이 값을 보도록 맞춰두기 위해 probe 에서도 동일하게 쓴다.
build --action_env=ASAN_OPTIONS=exitcode=55:halt_on_error=1

# 엔진을 libFuzzer 로 교체.
# 기본값이 //fuzzing/engines:replay 라서 이 줄이 없으면 파일 재생만 하고
# 퍼징을 하지 않는다. (실측: "Launching probe_bin as a Replay fuzz test...")
build --@rules_fuzzing//fuzzing:cc_engine=@rules_fuzzing//fuzzing/engines:libfuzzer
